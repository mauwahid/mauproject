{
  "name": "mauproject",
  "productName": "MauProject",
  "version": "1.0.0",
  "description": "MauProject — Project Management & Engineering Resource Planning for Engineering Managers",
  "author": "MauProject",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "icon": "node scripts/make-icon.js",
    "test": "node --test tests/*.test.mjs",
    "dist:mac": "npm run icon && vite build && electron-builder --mac dmg",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
